# A revision 1 chip.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

#
# USB Host (Espressif's usb component), for usbhost
#
# Hubs on, and a 4 KB control-transfer buffer in place of 256 bytes: a device
# whose configuration descriptor is bigger than the buffer never enumerates.
# usbhost's own sdkconfig says why. Builds without usbhost don't have the usb
# component, and ignore them.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
# end of USB Host
