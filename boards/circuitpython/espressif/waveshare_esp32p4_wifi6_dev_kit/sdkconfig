#
# Camera sensors (esp_cam_sensor)
#
# Every MIPI-CSI sensor driver esp_cam_sensor has, for cameraif, so any camera
# on the CSI connector is found: the same settings as cameraif's
# sdkconfig.esp32p4, which its tests/check_sensor_configs.py keeps in step.
# Each driver needs both options: without CONFIG_CAMERA_<chip> the driver isn't
# compiled, and without its AUTO_DETECT option the link drops its probe. Either
# way cameraif finds no sensor. Builds without cameraif don't have
# esp_cam_sensor, and ignore them.
#
# The OV5647 (the Waveshare boards' camera, the Raspberry Pi Camera (B) among
# them): the windows (800x800, 800x640, 800x1280, RAW8 at 50 fps), 1920x1080
# RAW10 at 30, and the whole sensor 2x2 binned, 1280x960 RAW10 at 45 -- the one
# whose flip and mirror turn the same picture over, and the quietest in a dim
# room.
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X800_50FPS=y

