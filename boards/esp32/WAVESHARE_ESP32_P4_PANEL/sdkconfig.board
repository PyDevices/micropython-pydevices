# The partition table beside this file. The path is relative to the esp32
# port directory, which is where idf.py runs; the layout is the work directory's
# (this repository beside the MicroPython clone).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../micropython-pydevices/boards/esp32/WAVESHARE_ESP32_P4_PANEL/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="../../../micropython-pydevices/boards/esp32/WAVESHARE_ESP32_P4_PANEL/partitions.csv"

# from cmods/esp32_partitions/ESP32_GENERIC_P4_C6_WIFI.sdkconfig
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# cameraif: the OV5647 on the panel's MIPI-CSI port.
#
# Two options, needed together, failing differently when absent. Without
# CONFIG_CAMERA_OV5647 the driver is not compiled. Without the AUTO_DETECT
# option it is compiled but its probe is dropped by --gc-sections, because
# esp_cam_sensor's detection walks a linker section rather than calling a
# symbol. Either way the detect array is empty and the camera reports as
# absent on the bus -- a wiring-shaped error with a build-configuration
# cause, which cost an hour to see because the message names SCCB.
#
# These live here rather than in the cameraif patch because usbif's P4 patch
# already appends to boards/sdkconfig.p4, and two mailbox patches editing the
# tail of one file collide on whichever applies second.
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y

# usbif: USB host settings the module needs (moved here from cmods' board
# patch, 2026-09-23). External hub support is off by default upstream, which
# makes a hub enumerate as a device the host stack cannot use with everything
# behind it invisible; a powered hub is also how a board that cannot source
# VBUS reaches a bus-powered peripheral at all. The control-transfer buffer is
# raised from IDF's 256-byte default because IDF allocates one per attached
# device and refuses any device whose configuration descriptor is larger: a
# USB audio CODEC publishes 1191 bytes, the bench camera 2306, and at the
# default they never enumerate -- no error, no event, just absent.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096

# BLE through the C6 companion (ESP-Hosted VHCI). Upstream's
# sdkconfig.p4_wifi_common turns NimBLE on but, unlike sdkconfig.ble (which the
# P4's hosted variants don't include), leaves two of its settings at IDF's
# defaults:
#
# - STATIC_TO_DYNAMIC defaults to y in IDF 5.5, which moves NimBLE's host
#   globals into a context struct allocated by nimble_port_init().
#   MicroPython's bindings zero ble_hs_max_attrs before that call, so
#   bluetooth.BLE().active(True) panics with a store access fault at 0x2.
# - NimBLE's host task defaults to core 0; MicroPython runs on core 1 on the
#   P4, and its ring buffer and scheduler expect the host on the same core.
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=n
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=n
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE=1
