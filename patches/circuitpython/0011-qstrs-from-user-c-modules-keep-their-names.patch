--- a/py/mkrules.mk
+++ b/py/mkrules.mk
@@ -158,7 +158,8 @@ $(HEADER_BUILD)/qstr.i.last: $(SRC_QSTR) $(QSTR_GLOBAL_DEPENDENCIES) | $(QSTR_GL
 
 $(HEADER_BUILD)/qstr.split: $(HEADER_BUILD)/qstr.i.last
