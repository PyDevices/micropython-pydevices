+//|         non_burst: bool = False,
+//|         continuous_clock: bool = False,
 //|     ) -> None:
 //|         """Create a MIPI DSI Display object connected to the given bus.
 //|
@@ -77,6 +79,10 @@
 //|         :param bool low_power_blanking: If True, the DSI lanes may drop to low power mode
 //|             during blanking. Set False to keep them in high speed mode, which bridges
 //|             that regenerate the pixel clock from the DSI clock (such as the LT8912B) need.
+//|         :param bool non_burst: Send non-burst video with sync pulses instead of burst video. DSI-to-RGB
+//|             bridges such as the Chipone ICN6211 on Raspberry Pi-style panels need it.
+//|         :param bool continuous_clock: Keep the clock lane in high-speed mode instead of letting it drop
+//|             to low power between lines. The same bridges need it.
 //|         """
 //|
 
@@ -85,7 +91,7 @@ static mp_obj_t mipidsi_display_make_new(const mp_obj_type_t *type, size_t n_arg
            ARG_hsync_front_porch, ARG_vsync_pulse_width, ARG_vsync_back_porch, ARG_vsync_front_porch,
            ARG_pixel_clock_frequency, ARG_virtual_channel, ARG_rotation,
            ARG_color_depth, ARG_backlight_pin, ARG_brightness, ARG_native_frames_per_second,
-           ARG_backlight_on_high, ARG_low_power_blanking };
+           ARG_backlight_on_high, ARG_low_power_blanking, ARG_non_burst, ARG_continuous_clock };
     static const mp_arg_t allowed_args[] = {
         { MP_QSTR_bus, MP_ARG_REQUIRED | MP_ARG_OBJ },
         { MP_QSTR_init_sequence, MP_ARG_REQUIRED | MP_ARG_OBJ },
@@ -106,6 +112,8 @@ static mp_obj_t mipidsi_display_make_new(const mp_obj_type_t *type, size_t n_arg
         { MP_QSTR_native_frames_per_second, MP_ARG_INT | MP_ARG_KW_ONLY, {.u_int = 60} },
         { MP_QSTR_backlight_on_high, MP_ARG_BOOL | MP_ARG_KW_ONLY, {.u_bool = true} },
         { MP_QSTR_low_power_blanking, MP_ARG_BOOL | MP_ARG_KW_ONLY, {.u_bool = true} },
+        { MP_QSTR_non_burst, MP_ARG_BOOL | MP_ARG_KW_ONLY, {.u_bool = false} },
+        { MP_QSTR_continuous_clock, MP_ARG_BOOL | MP_ARG_KW_ONLY, {.u_bool = false} },
     };
     mp_arg_val_t args[MP_ARRAY_SIZE(allowed_args)];
     mp_arg_parse_all_kw_array(n_args, n_kw, all_args, MP_ARRAY_SIZE(allowed_args), allowed_args, args);
@@ -149,7 +157,9 @@ static mp_obj_t mipidsi_display_make_new(const mp_obj_type_t *type, size_t n_arg
         args[ARG_vsync_back_porch].u_int,
         args[ARG_vsync_front_porch].u_int,
         args[ARG_pixel_clock_frequency].u_int,
-        args[ARG_low_power_blanking].u_bool);
+        args[ARG_low_power_blanking].u_bool,
+        args[ARG_non_burst].u_bool,
+        args[ARG_continuous_clock].u_bool);
 
     return MP_OBJ_FROM_PTR(self);
 }
