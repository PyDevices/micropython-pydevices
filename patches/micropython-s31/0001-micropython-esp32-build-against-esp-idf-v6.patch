@@ -380,6 +397,12 @@ static mp_obj_t ssl_context_make_new(const mp_obj_type_t *type_in, size_t n_args
     psa_crypto_init();
     #endif
 
+    #if MBEDTLS_VERSION_MAJOR >= 4
