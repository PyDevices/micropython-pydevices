     if (self->is_dtls_server) {
@@ -548,7 +580,12 @@ static MP_DEFINE_CONST_FUN_OBJ_2(ssl_context_set_ciphers_obj, ssl_context_set_ci
 static void ssl_context_load_key(mp_obj_ssl_context_t *self, mp_obj_t key_obj, mp_obj_t cert_obj) {
     size_t key_len;
     const unsigned char *key = asn1_get_data(key_obj, &key_len);
+    #if MBEDTLS_VERSION_MAJOR >= 4
+    // mbedtls 4.x: RNG parameters removed, PSA Crypto handles blinding.
+    int ret = mbedtls_pk_parse_key(&self->pkey, key, key_len, NULL, 0);
