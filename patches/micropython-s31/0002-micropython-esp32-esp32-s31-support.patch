 #define CFG_TUSB_RHPORT1_MODE   (OPT_MODE_DEVICE | OPT_MODE_HIGH_SPEED)
 #endif
 #endif
+#endif // MICROPY_HW_USB_HS target block
 
 // The highest IN endpoint number with a transmit FIFO: the P4's high-speed
