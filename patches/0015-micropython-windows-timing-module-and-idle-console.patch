+// _timing: one OS timer that wakes the main thread, for a port with no
+// signals, no machine.Timer and no threads in the VM.
+//
+//     import _timing
+//     _timing.init(callback)   # a callable of one argument (None)
+//     _timing.arm(ms)          # one-shot: callback is scheduled in ms
+//     _timing.cancel()
+//
+// A timer-queue thread only sets a flag when the deadline passes. The main
+// thread notices it in the VM's periodic hook, in mp_event_wait_ms (so
+// time.sleep_ms sees it), and in the console wait of mp_hal_stdin_rx_chr
+// (so the REPL sees it while it waits for a key), and hands the callback to
+// mp_sched_schedule from its own context. So the callback runs at a bytecode
+// boundary of the main thread, exactly as machine.Timer's soft callbacks do
+// on a board, and no VM state is ever touched from the timer thread.
+
+#include <windows.h>
+
+#include "py/runtime.h"
+#include "py/mphal.h"
+
+#if MICROPY_PY_TIMING
+
+static HANDLE timing_queue = NULL;
+static HANDLE timing_timer = NULL;
+static volatile LONG timing_pending = 0;
+
+static void CALLBACK timing_expired(PVOID param, BOOLEAN fired) {
+    (void)param;
+    (void)fired;
+    InterlockedExchange(&timing_pending, 1);
+}
+
+// Called from the main thread at safe points (see the header comment).
+void mp_timing_poll(void) {
+    if (!timing_pending) {
+        return;
+    }
+    mp_obj_t cb = MP_STATE_PORT(timing_callback);
+    if (InterlockedExchange(&timing_pending, 0) && cb != MP_OBJ_NULL) {
+        // A full scheduler queue means the VM is not draining it; the next
+        // arm() retries, and multimer counts the miss.
+        mp_sched_schedule(cb, mp_const_none);
+    }
+}
+
+static void timing_cancel_timer(void) {
+    if (timing_timer != NULL) {
+        // INVALID_HANDLE_VALUE waits for a running callback to finish, so no
+        // callback can set the flag after this returns.
+        DeleteTimerQueueTimer(timing_queue, timing_timer, INVALID_HANDLE_VALUE);
+        timing_timer = NULL;
+    }
+    InterlockedExchange(&timing_pending, 0);
+}
+
+static mp_obj_t timing_init(mp_obj_t callback) {
+    if (!mp_obj_is_callable(callback)) {
+        mp_raise_TypeError(MP_ERROR_TEXT("callback must be callable"));
+    }
+    if (timing_queue == NULL) {
+        timing_queue = CreateTimerQueue();
+        if (timing_queue == NULL) {
+            mp_raise_OSError(GetLastError());
+        }
+    }
+    timing_cancel_timer();
+    MP_STATE_PORT(timing_callback) = callback;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(timing_init_obj, timing_init);
+
+static mp_obj_t timing_arm(mp_obj_t ms_in) {
+    mp_int_t ms = mp_obj_get_int(ms_in);
+    if (ms < 0) {
+        ms = 0;
+    }
+    if (timing_queue == NULL || MP_STATE_PORT(timing_callback) == MP_OBJ_NULL) {
+        mp_raise_ValueError(MP_ERROR_TEXT("init() first"));
+    }
+    timing_cancel_timer();
+    if (!CreateTimerQueueTimer(&timing_timer, timing_queue, timing_expired, NULL,
+        (DWORD)ms, 0, WT_EXECUTEONLYONCE)) {
+        timing_timer = NULL;
+        mp_raise_OSError(GetLastError());
+    }
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(timing_arm_obj, timing_arm);
+
+static mp_obj_t timing_cancel(void) {
+    timing_cancel_timer();
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(timing_cancel_obj, timing_cancel);
+
+static const mp_rom_map_elem_t timing_module_globals_table[] = {
+    { MP_ROM_QSTR(MP_QSTR___name__), MP_ROM_QSTR(MP_QSTR__timing) },
+    { MP_ROM_QSTR(MP_QSTR_init), MP_ROM_PTR(&timing_init_obj) },
+    { MP_ROM_QSTR(MP_QSTR_arm), MP_ROM_PTR(&timing_arm_obj) },
+    { MP_ROM_QSTR(MP_QSTR_cancel), MP_ROM_PTR(&timing_cancel_obj) },
+};
+static MP_DEFINE_CONST_DICT(timing_module_globals, timing_module_globals_table);
+
+const mp_obj_module_t mp_module_timing = {
+    .base = { &mp_type_module },
+    .globals = (mp_obj_dict_t *)&timing_module_globals,
+};
+
+MP_REGISTER_MODULE(MP_QSTR__timing, mp_module_timing);
+MP_REGISTER_ROOT_POINTER(mp_obj_t timing_callback);
+
+#endif // MICROPY_PY_TIMING
