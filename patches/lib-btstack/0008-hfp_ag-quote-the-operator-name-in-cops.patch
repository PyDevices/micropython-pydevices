From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:00:00 -0500
Subject: [PATCH] hfp_ag: quote the operator name in +COPS

The Hands-Free spec has the gateway answer AT+COPS? with the name in quotes
(+COPS: 0,0,"name"). BTstack sent it bare, which its own hands-free parser
takes but Bluedroid's does not: it reads an empty name.

diff --git a/src/classic/hfp_ag.c b/src/classic/hfp_ag.c
--- a/src/classic/hfp_ag.c
+++ b/src/classic/hfp_ag.c
@@ -484,7 +484,7 @@
         snprintf(buffer, sizeof(buffer), "\r\n%s:%d,,\r\n\r\nOK\r\n", HFP_QUERY_OPERATOR_SELECTION, op.mode);
     } else {
         int offset = snprintf(buffer,  sizeof(buffer), "\r\n%s:%d,%d,", HFP_QUERY_OPERATOR_SELECTION, op.mode, op.format);
-        offset += snprintf(buffer+offset, 16, "%s", op.name);
+        offset += snprintf(buffer+offset, 18, "\"%.15s\"", op.name);
         snprintf(buffer+offset, sizeof(buffer)-offset, "\r\n\r\nOK\r\n");
     }
     return send_str_over_rfcomm(cid, buffer);
