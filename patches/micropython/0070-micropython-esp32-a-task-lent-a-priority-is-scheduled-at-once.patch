+
+// A task that inherits a priority is scheduled at once, on a chip with two
+// cores.
+//
+// When a task waits for a mutex, FreeRTOS lends its priority to the mutex's
+// holder. ESP-IDF's xTaskPriorityInherit() moves a holder that is ready to
+// run into the ready list of its new priority, and stops there. If the holder
+// is pinned to the other core and a task of its old priority is running
+// there, nothing tells that core to look again: the tick only shares time
+// between tasks of the running task's own priority, and the holder has just
+// left that list. The holder then waits until the running task blocks or
+// yields of its own accord, and the high-priority task waits with it.
+//
+// Seen on an ESP32-P4: the main thread, cut off by a time slice while holding
+// a mutex, stayed off the CPU for 50 to 90 ms although it had been lent
+// priority 7 or 21, while a second Python thread at priority 1 computed a TLS
+// handshake on the same core. An audio task on the other core waited for it.
+//
+// So the link wraps xTaskPriorityInherit(): after a priority has been lent,
+// each other core the holder may run on, and isn't running on, is asked to
+// choose its task again.
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/idf_additions.h"
+
+#if CONFIG_FREERTOS_NUMBER_OF_CORES > 1
+
+BaseType_t __real_xTaskPriorityInherit(TaskHandle_t const pxMutexHolder);
+
+BaseType_t __wrap_xTaskPriorityInherit(TaskHandle_t const pxMutexHolder) {
+    BaseType_t inherited = __real_xTaskPriorityInherit(pxMutexHolder);
+    if (inherited != pdFALSE && pxMutexHolder != NULL) {
+        const BaseType_t here = xPortGetCoreID();
+        const BaseType_t affinity = xTaskGetCoreID(pxMutexHolder);
+        for (BaseType_t core = 0; core < CONFIG_FREERTOS_NUMBER_OF_CORES; core++) {
+            // This core's task is about to block on the mutex, and will
+            // choose again then.
+            if (core != here && (affinity == tskNO_AFFINITY || affinity == core)
+                && xTaskGetCurrentTaskHandleForCore(core) != pxMutexHolder) {
+                vPortYieldOtherCore(core);
+            }
+        }
+    }
+    return inherited;
+}
+
+#else
+
+BaseType_t __real_xTaskPriorityInherit(TaskHandle_t const pxMutexHolder);
+
+BaseType_t __wrap_xTaskPriorityInherit(TaskHandle_t const pxMutexHolder) {
+    return __real_xTaskPriorityInherit(pxMutexHolder);
+}
+
+#endif
