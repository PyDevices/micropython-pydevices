From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:00:00 -0500
Subject: [PATCH] esp32/machine_sdcard: Reset the host and retry a failed transfer.

On an ESP32-P4, long runs of 4 KB writes to a microSD card fail now and
then, about once every 10 to 15 MB while the card is served over USB
mass storage. Either the card stays busy past the 5 s ready timeout, or
the controller's DMA stops partway through a block and leaves its data
path busy, after which every command times out until the controller is
reset. The write returned -EIO, the next one hung for 5 s too, and the
host gave up on the disk.

When a transfer fails on an SDMMC host, reset the controller, its DMA
and its FIFO, initialise the card again and repeat the transfer once.
Recovery takes about 50 ms. The reset is ESP-IDF's sdmmc_host_reset(),
which keeps the clock, interrupt and slot settings, so a second slot on
the same controller keeps working. SPI hosts are unchanged.

diff --git a/ports/esp32/machine_sdcard.c b/ports/esp32/machine_sdcard.c
--- a/ports/esp32/machine_sdcard.c
+++ b/ports/esp32/machine_sdcard.c
@@ -530,7 +530,7 @@ static MP_DEFINE_CONST_FUN_OBJ_1(sd_info_obj, sd_info);
 // Read or write whole sectors. A buffer the host can DMA into goes straight
 // through; anything else is staged through a DMA-capable buffer a few
 // sectors at a time, so the card still sees multi-sector transfers.
-static esp_err_t sdcard_transfer(sdcard_card_obj_t *self, uint8_t *buf, size_t block, size_t count, bool write) {
+static esp_err_t sdcard_transfer_once(sdcard_card_obj_t *self, uint8_t *buf, size_t block, size_t count, bool write) {
     size_t sector = _SECTOR_SIZE(self);
     bool direct = self->card.host.check_buffer_alignment == NULL
         || self->card.host.check_buffer_alignment(self->card.host.slot, buf, sector * count);
@@ -569,6 +569,28 @@ static esp_err_t sdcard_transfer(sdcard_card_obj_t *self, uint8_t *buf, size_t b
     return ESP_OK;
 }
 
+#if SOC_SDMMC_HOST_SUPPORTED
+// Not in ESP-IDF's public headers: resets the SDMMC controller, its DMA and
+// its FIFO, and keeps the clock, interrupt and slot settings.
+esp_err_t sdmmc_host_reset(void);
+#endif
+
+// A failed transfer can leave the SDMMC controller's data path stuck mid-block,
+// so that every later command times out as well, or leave the card in its
+// programming state. Reset the controller, initialise the card again and try
+// once more. Repeating a transfer is safe: it writes or reads the same sectors.
+static esp_err_t sdcard_transfer(sdcard_card_obj_t *self, uint8_t *buf, size_t block, size_t count, bool write) {
+    esp_err_t err = sdcard_transfer_once(self, buf, block, count, write);
+    #if SOC_SDMMC_HOST_SUPPORTED
+    if (err != ESP_OK && !(self->host.flags & SDMMC_HOST_FLAG_SPI)) {
+        if (sdmmc_host_reset() == ESP_OK && sdcard_ensure_card_init(self, true) == ESP_OK) {
+            err = sdcard_transfer_once(self, buf, block, count, write);
+        }
+    }
+    #endif
+    return err;
+}
+
 static mp_obj_t machine_sdcard_readblocks(mp_obj_t self_in, mp_obj_t block_num, mp_obj_t buf) {
     sdcard_card_obj_t *self = self_in;
     mp_buffer_info_t bufinfo;
