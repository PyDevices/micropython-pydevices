From a5282f521823ba5bf670a2d6dcdf4dd76caef5b2 Mon Sep 17 00:00:00 2001
From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Fri, 16 Oct 2026 05:31:15 -0500
Subject: [PATCH] extmod/machine_usb_device: UVC payloads on an IN stream.

USBDevice.stream(ep, ring, packet, frame) with frame > 0 sends video:
frame-byte frames from the ring, each isochronous packet led by UVC's 2-byte
payload header (the frame ID bit toggled per frame, end-of-frame on a
frame's last packet). A frame starts only once the whole of it is in the
ring, so a slow producer gives empty packets, never a torn frame.
---
 extmod/machine_usb_device.c      | 10 +++++++---
 shared/tinyusb/mp_usbd.h         |  4 +++-
 shared/tinyusb/mp_usbd_runtime.c | 32 ++++++++++++++++++++++++++++++--
 3 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/extmod/machine_usb_device.c b/extmod/machine_usb_device.c
index 1970e6193..1eadbff1f 100644
--- a/extmod/machine_usb_device.c
+++ b/extmod/machine_usb_device.c
@@ -316,18 +316,22 @@ static mp_obj_t usb_device_speed(mp_obj_t self_in) {
 }
 static MP_DEFINE_CONST_FUN_OBJ_1(usb_device_speed_obj, usb_device_speed);
 
-// USBDevice.stream(ep, ring, packet): from now on C moves this endpoint's
+// USBDevice.stream(ep, ring, packet, frame=0): from now on C moves this endpoint's
 // packets, to or from ring (a USBDevice.Ring), from the transfer interrupt;
 // packet is the bytes per transfer. stream(ep, None) stops it. For the
 // isochronous endpoints of audio and video, started when the host selects
 // the streaming alternate setting and stopped when it goes back to zero.
+// frame > 0 on an IN endpoint sends UVC video: frame-byte frames from the
+// ring, each packet with its payload header (FID toggled per frame, EOF on a
+// frame's last packet), a frame started only once the whole of it is there.
 static mp_obj_t usb_device_stream(size_t n_args, const mp_obj_t *args) {
     mp_obj_usb_device_t *usbd = MP_OBJ_TO_PTR(args[0]);
     uint16_t packet = n_args > 3 ? (uint16_t)mp_obj_get_int(args[3]) : 0;
-    mp_usbd_stream_attach(usbd, (uint8_t)mp_obj_get_int(args[1]), args[2], packet);
+    uint32_t frame = n_args > 4 ? (uint32_t)mp_obj_get_int(args[4]) : 0;
+    mp_usbd_stream_attach(usbd, (uint8_t)mp_obj_get_int(args[1]), args[2], packet, frame);
     return mp_const_none;
 }
-static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(usb_device_stream_obj, 3, 4, usb_device_stream);
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(usb_device_stream_obj, 3, 5, usb_device_stream);
 
 // USBDevice.feedback(ep, value): keep an explicit-feedback endpoint sending
 // value (3 bytes, 10.14 at full speed; 4 bytes, 16.16 at high speed) on
diff --git a/shared/tinyusb/mp_usbd.h b/shared/tinyusb/mp_usbd.h
index 5f6b9ab59..5ee4d2eab 100644
--- a/shared/tinyusb/mp_usbd.h
+++ b/shared/tinyusb/mp_usbd.h
@@ -202,7 +202,9 @@ typedef struct {
 extern const mp_obj_type_t mp_usbd_ring_type;
 // Attach a ring to an endpoint (ring None detaches); packet is the bytes per
 // transfer. Feedback endpoints carry a fixed value instead of a ring.
-void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t ring, uint16_t packet);
+// frame > 0 makes an IN stream a UVC video payload: frame-byte frames from the
+// ring, each packet with its 2-byte payload header.
+void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t ring, uint16_t packet, uint32_t frame);
 void mp_usbd_stream_feedback(mp_obj_usb_device_t *usbd, uint8_t ep_addr, const uint8_t *value, size_t len);
 bool mp_usbd_stream_stats(uint8_t ep_addr, uint32_t *packets, uint32_t *bytes, uint32_t *drops);
 
diff --git a/shared/tinyusb/mp_usbd_runtime.c b/shared/tinyusb/mp_usbd_runtime.c
index 4c098d921..fe0a22d09 100644
--- a/shared/tinyusb/mp_usbd_runtime.c
+++ b/shared/tinyusb/mp_usbd_runtime.c
@@ -560,6 +560,9 @@ typedef struct {
     bool feedback;
     volatile bool active;
     uint16_t packet;            // bytes per transfer
+    uint32_t frame;             // video: bytes per frame (0: a plain stream)
+    uint32_t frame_pos;         // video: bytes of the current frame sent
+    uint8_t fid;                // video: the frame ID bit, toggled per frame
     mp_usbd_ring_obj_t *ring;   // data streams
     uint8_t *pkt;               // the transfer's buffer
     uint8_t fb_len;
@@ -583,6 +586,27 @@ static MP_USBD_ISR_ATTR void stream_arm(mp_usbd_stream_t *s, bool in_isr) {
     if (s->feedback) {
         memcpy(s->pkt, s->fb, s->fb_len);
         n = s->fb_len;
+    } else if (tu_edpt_dir(s->ep) == TUSB_DIR_IN && s->frame) {
+        // A UVC payload: a 2-byte header (length, then FID and, on a frame's
+        // last packet, EOF) and the next part of the frame. A frame starts
+        // only when the whole of it is in the ring, so it can't tear; until
+        // then the host gets empty packets, which UVC allows.
+        if (s->frame_pos == 0 && ring_used(s->ring) < s->frame) {
+            n = 0;
+        } else {
+            uint32_t left = s->frame - s->frame_pos;
+            uint32_t chunk = s->packet - 2u < left ? s->packet - 2u : left;
+            ring_read(s->ring, s->pkt + 2, chunk);
+            s->frame_pos += chunk;
+            s->pkt[0] = 2;
+            s->pkt[1] = 0x80 | s->fid;          // EOH, FID
+            if (s->frame_pos >= s->frame) {
+                s->pkt[1] |= 0x02;              // EOF
+                s->frame_pos = 0;
+                s->fid ^= 1;
+            }
+            n = (uint16_t)(chunk + 2);
+        }
     } else if (tu_edpt_dir(s->ep) == TUSB_DIR_IN) {
         n = (uint16_t)ring_read(s->ring, s->pkt, s->packet);
     }
@@ -638,7 +662,7 @@ static void stream_release(mp_obj_usb_device_t *usbd, int i) {
     usbd->stream_objs[i][1] = mp_const_none;
 }
 
-void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t ring, uint16_t packet) {
+void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t ring, uint16_t packet, uint32_t frame) {
     int i;
     mp_usbd_stream_t *s = stream_slot(usbd, ep_addr, &i);
     if (ring == mp_const_none) {
@@ -650,7 +674,7 @@ void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t
     if (!mp_obj_is_type(ring, &mp_usbd_ring_type)) {
         mp_raise_TypeError(MP_ERROR_TEXT("expected USBDevice.Ring"));
     }
-    if (packet == 0) {
+    if (packet == 0 || (frame && packet <= 2)) {
         mp_raise_ValueError(MP_ERROR_TEXT("packet"));
     }
     s->active = false;
@@ -660,6 +684,9 @@ void mp_usbd_stream_attach(mp_obj_usb_device_t *usbd, uint8_t ep_addr, mp_obj_t
     s->ring = MP_OBJ_TO_PTR(ring);
     s->pkt = ((mp_obj_array_t *)MP_OBJ_TO_PTR(pkt))->items;
     s->packet = packet;
+    s->frame = frame;
+    s->frame_pos = 0;
+    s->fid = 0;
     s->feedback = false;
     s->packets = s->bytes = s->drops = 0;
     s->ep = ep_addr;
@@ -690,6 +717,7 @@ void mp_usbd_stream_feedback(mp_obj_usb_device_t *usbd, uint8_t ep_addr, const u
         usbd->stream_objs[i][1] = pkt;
         s->pkt = ((mp_obj_array_t *)MP_OBJ_TO_PTR(pkt))->items;
         s->feedback = true;
+        s->frame = 0;
         s->packets = s->bytes = s->drops = 0;
         s->ep = ep_addr;
         s->active = true;
-- 
2.43.0

