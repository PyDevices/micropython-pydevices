From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:13:19 -0600
Subject: [PATCH] shared/runtime/pyexec: say how long the REPL has waited for a
 command.

micropython.repl_idle_ms() returns -1 while the REPL runs a command (or
while something other than the REPL runs), and otherwise how many
milliseconds the REPL has waited for a new command with no input. The
friendly REPL's line reads and the raw REPL's wait for the first character
of a command count as waiting. A paste, a raw paste, a program's own
input() and everything a command runs don't. WebREPL counts every read it
makes as input, since a file transfer never hands the REPL a character.

A timer library can then tell an idle prompt from a busy one. multimer
uses it to run a callback that is slower than its period back to back
while the REPL waits, and to keep the pause it otherwise leaves after each
pass while a command or a transfer runs.

The option is off by default, and the esp32 port turns it on.
---
 extmod/modwebrepl.c        |  8 ++++++++
 ports/esp32/mpconfigport.h |  1 +
 py/modmicropython.c        | 14 ++++++++++++++
 py/mpconfig.h              |  6 ++++++
 shared/runtime/pyexec.c    | 33 +++++++++++++++++++++++++++++++++
 shared/runtime/pyexec.h    |  5 +++++
 6 files changed, 67 insertions(+)

diff --git a/extmod/modwebrepl.c b/extmod/modwebrepl.c
index bac223d95..406ac7560 100644
--- a/extmod/modwebrepl.c
+++ b/extmod/modwebrepl.c
@@ -35,6 +35,9 @@
 #include "py/mphal.h"
 #endif
 #include "extmod/modwebsocket.h"
+#if MICROPY_PY_MICROPYTHON_REPL_IDLE
+#include "shared/runtime/pyexec.h"
+#endif
 
 #if MICROPY_PY_WEBREPL
 
@@ -194,6 +197,11 @@ static mp_uint_t _webrepl_read(mp_obj_t self_in, void *buf, mp_uint_t size, int
         return out_sz;
     }
 
+    #if MICROPY_PY_MICROPYTHON_REPL_IDLE
+    // A file transfer never hands the REPL a character, so count it here.
+    pyexec_repl_input();
+    #endif
+
     if (self->state == STATE_PASSWD) {
         char c = *(char *)buf;
         if (c == '\r' || c == '\n') {
diff --git a/ports/esp32/mpconfigport.h b/ports/esp32/mpconfigport.h
index ecdc4b238..77c1ada27 100644
--- a/ports/esp32/mpconfigport.h
+++ b/ports/esp32/mpconfigport.h
@@ -77,6 +77,7 @@
 // control over Python builtins
 #define MICROPY_PY_STR_BYTES_CMP_WARN       (1)
 #define MICROPY_PY_ALL_INPLACE_SPECIAL_METHODS (1)
+#define MICROPY_PY_MICROPYTHON_REPL_IDLE    (1)
 #define MICROPY_PY_BUILTINS_HELP_TEXT       esp32_help_text
 #define MICROPY_PY_IO_BUFFEREDWRITER        (1)
 #define MICROPY_PY_TIME_GMTIME_LOCALTIME_MKTIME (1)
diff --git a/py/modmicropython.c b/py/modmicropython.c
index 35ca98eb8..6db9066bd 100644
--- a/py/modmicropython.c
+++ b/py/modmicropython.c
@@ -32,6 +32,10 @@
 #include "py/gc.h"
 #include "py/mphal.h"
 
+#if MICROPY_PY_MICROPYTHON_REPL_IDLE
+#include "shared/runtime/pyexec.h"
+#endif
+
 #if MICROPY_PY_MICROPYTHON
 
 // Various builtins specific to MicroPython runtime,
@@ -144,6 +148,13 @@ static MP_DEFINE_CONST_FUN_OBJ_0(mp_micropython_heap_locked_obj, mp_micropython_
 #endif
 #endif
 
+#if MICROPY_PY_MICROPYTHON_REPL_IDLE
+static mp_obj_t mp_micropython_repl_idle_ms(void) {
+    return MP_OBJ_NEW_SMALL_INT(pyexec_repl_idle_ms());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mp_micropython_repl_idle_ms_obj, mp_micropython_repl_idle_ms);
+#endif
+
 #if MICROPY_ENABLE_EMERGENCY_EXCEPTION_BUF && (MICROPY_EMERGENCY_EXCEPTION_BUF_SIZE == 0)
 static MP_DEFINE_CONST_FUN_OBJ_1(mp_alloc_emergency_exception_buf_obj, mp_alloc_emergency_exception_buf);
 #endif
@@ -228,6 +239,9 @@ static const mp_rom_map_elem_t mp_module_micropython_globals_table[] = {
     #if MICROPY_ENABLE_SCHEDULER
     { MP_ROM_QSTR(MP_QSTR_schedule), MP_ROM_PTR(&mp_micropython_schedule_obj) },
     #endif
+    #if MICROPY_PY_MICROPYTHON_REPL_IDLE
+    { MP_ROM_QSTR(MP_QSTR_repl_idle_ms), MP_ROM_PTR(&mp_micropython_repl_idle_ms_obj) },
+    #endif
 };
 
 static MP_DEFINE_CONST_DICT(mp_module_micropython_globals, mp_module_micropython_globals_table);
diff --git a/py/mpconfig.h b/py/mpconfig.h
index 1edc0804e..dcef01f26 100644
--- a/py/mpconfig.h
+++ b/py/mpconfig.h
@@ -1609,6 +1609,12 @@ typedef time_t mp_timestamp_t;
 #define MICROPY_PY_MICROPYTHON_HEAP_LOCKED (MICROPY_CONFIG_ROM_LEVEL_AT_LEAST_EVERYTHING)
 #endif
 
+// Whether to provide "micropython.repl_idle_ms", how long the REPL has waited
+// for a new command (needs the REPL in shared/runtime/pyexec.c, not event driven)
+#ifndef MICROPY_PY_MICROPYTHON_REPL_IDLE
+#define MICROPY_PY_MICROPYTHON_REPL_IDLE (0)
+#endif
+
 // Support for micropython.RingIO()
 #ifndef MICROPY_PY_MICROPYTHON_RINGIO
 #define MICROPY_PY_MICROPYTHON_RINGIO (MICROPY_CONFIG_ROM_LEVEL_AT_LEAST_EXTRA_FEATURES)
diff --git a/shared/runtime/pyexec.c b/shared/runtime/pyexec.c
index bbb85543c..b0bce54bb 100644
--- a/shared/runtime/pyexec.c
+++ b/shared/runtime/pyexec.c
@@ -42,6 +42,33 @@
 
 pyexec_mode_kind_t pyexec_mode_kind = PYEXEC_MODE_FRIENDLY_REPL;
 
+#if MICROPY_PY_MICROPYTHON_REPL_IDLE
+// Whether the REPL is waiting for a new command, and when it began to or last
+// saw input, for micropython.repl_idle_ms().
+static bool repl_waiting;
+static mp_uint_t repl_quiet_since;
+
+static void repl_wait(bool waiting) {
+    repl_waiting = waiting;
+    repl_quiet_since = mp_hal_ticks_ms();
+}
+
+void pyexec_repl_input(void) {
+    repl_quiet_since = mp_hal_ticks_ms();
+}
+
+mp_int_t pyexec_repl_idle_ms(void) {
+    if (!repl_waiting) {
+        return -1;
+    }
+    mp_uint_t quiet = mp_hal_ticks_ms() - repl_quiet_since;
+    return quiet < 0x3fffffff ? (mp_int_t)quiet : 0x3fffffff;
+}
+#else
+// A macro rather than a function, since an event-driven REPL never calls it.
+#define repl_wait(waiting) ((void)(waiting))
+#endif
+
 #if MICROPY_REPL_INFO
 static bool repl_display_debugging_info = 0;
 #endif
@@ -562,7 +589,9 @@ raw_repl_reset:
         vstr_reset(&line);
         mp_hal_stdout_tx_str(">");
         for (;;) {
+            repl_wait(vstr_len(&line) == 0);
             int c = mp_hal_stdin_rx_chr();
+            repl_wait(false);
             if (c == CHAR_CTRL_A) {
                 // reset raw REPL
                 if (vstr_len(&line) == 2 && vstr_str(&line)[0] == CHAR_CTRL_E) {
@@ -655,7 +684,9 @@ friendly_repl_reset:
         MP_STATE_THREAD(gc_lock_depth) = 0;
 
         vstr_reset(&line);
+        repl_wait(true);
         int ret = readline(&line, mp_repl_get_ps1());
+        repl_wait(false);
         mp_parse_input_kind_t parse_input_kind = MP_PARSE_SINGLE_INPUT;
 
         if (ret == CHAR_CTRL_A) {
@@ -710,7 +741,9 @@ friendly_repl_reset:
             // got a line with non-zero length, see if it needs continuing
             while (mp_repl_continue_with_input(vstr_null_terminated_str(&line))) {
                 vstr_add_byte(&line, '\n');
+                repl_wait(true);
                 ret = readline(&line, mp_repl_get_ps2());
+                repl_wait(false);
                 if (ret == CHAR_CTRL_C) {
                     // cancel everything
                     mp_hal_stdout_tx_str("\r\n");
diff --git a/shared/runtime/pyexec.h b/shared/runtime/pyexec.h
index fb52c09b1..e1e387227 100644
--- a/shared/runtime/pyexec.h
+++ b/shared/runtime/pyexec.h
@@ -58,6 +58,11 @@ void pyexec_event_repl_init(void);
 int pyexec_event_repl_process_char(int c);
 extern uint8_t pyexec_repl_active;
 
+#if MICROPY_PY_MICROPYTHON_REPL_IDLE
+void pyexec_repl_input(void);
+mp_int_t pyexec_repl_idle_ms(void);
+#endif
+
 #if MICROPY_REPL_INFO
 mp_obj_t pyb_set_repl_info(mp_obj_t o_value);
 MP_DECLARE_CONST_FUN_OBJ_1(pyb_set_repl_info_obj);
-- 
