@@ -708,10 +795,66 @@
 // stream, and one replaced while it may still be queued is kept in
 // stream_objs[i][2] until it can't be.
 
+#if MP_USBD_ISR_IN_IRAM
+// A packet buffer in internal RAM (see above), freed with its object.
+typedef struct {
+    mp_obj_base_t base;
+    uint8_t *items;
+    size_t len;
+} mp_usbd_packet_buf_t;
+
+static mp_obj_t mp_usbd_packet_buf_del(mp_obj_t self_in) {
+    mp_usbd_packet_buf_t *self = MP_OBJ_TO_PTR(self_in);
+    heap_caps_free(self->items);
+    self->items = NULL;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mp_usbd_packet_buf_del_obj, mp_usbd_packet_buf_del);
+
+static const mp_rom_map_elem_t mp_usbd_packet_buf_locals_dict_table[] = {
+    { MP_ROM_QSTR(MP_QSTR___del__), MP_ROM_PTR(&mp_usbd_packet_buf_del_obj) },
+};
+static MP_DEFINE_CONST_DICT(mp_usbd_packet_buf_locals_dict, mp_usbd_packet_buf_locals_dict_table);
+
+static MP_DEFINE_CONST_OBJ_TYPE(
+    mp_usbd_packet_buf_type,
+    MP_QSTR_PacketBuffer,
+    MP_TYPE_FLAG_NONE,
+    locals_dict, &mp_usbd_packet_buf_locals_dict
+    );
+
+static mp_obj_t stream_new_buffer(uint16_t size) {
+    mp_usbd_packet_buf_t *b = mp_obj_malloc_with_finaliser(mp_usbd_packet_buf_t, &mp_usbd_packet_buf_type);
+    b->len = 0;
+    b->items = heap_caps_malloc(size, MP_USBD_INTERNAL);
+    if (b->items == NULL) {
+        m_malloc_fail(size);
+    }
+    b->len = size;
+    return MP_OBJ_FROM_PTR(b);
+}
+
+static uint8_t *stream_items(mp_obj_t buf) {
+    return ((mp_usbd_packet_buf_t *)MP_OBJ_TO_PTR(buf))->items;
+}
+
+static size_t stream_items_len(mp_obj_t buf) {
+    return ((mp_usbd_packet_buf_t *)MP_OBJ_TO_PTR(buf))->len;
+}
+#else
+static mp_obj_t stream_new_buffer(uint16_t size) {
+    return mp_obj_new_bytearray_by_ref(size, m_new(uint8_t, size));
+}
+
 static uint8_t *stream_items(mp_obj_t buf) {
     return ((mp_obj_array_t *)MP_OBJ_TO_PTR(buf))->items;
 }
 
+static size_t stream_items_len(mp_obj_t buf) {
+    return ((mp_obj_array_t *)MP_OBJ_TO_PTR(buf))->len;
+}
+#endif
+
 // Whether the controller may still write to (or send from) buf.
 static bool stream_holds(mp_usbd_stream_t *s, mp_obj_t buf) {
     return buf != mp_const_none && s->last_ep != 0 && s->queued == stream_items(buf)
@@ -748,11 +891,11 @@
     if (!stream_holds(s, objs[2])) {
         objs[2] = mp_const_none;
     }
-    if (objs[1] == mp_const_none || ((mp_obj_array_t *)MP_OBJ_TO_PTR(objs[1]))->len < size) {
+    if (objs[1] == mp_const_none || stream_items_len(objs[1]) < size) {
         if (stream_holds(s, objs[1])) {
             objs[2] = objs[1];
         }
-        objs[1] = mp_obj_new_bytearray_by_ref(size, m_new(uint8_t, size));
+        objs[1] = stream_new_buffer(size);
     }
     s->pkt = stream_items(objs[1]);
     s->last_ep = ep_addr;
@@ -784,7 +927,7 @@
     s->active = false;
     stream_buffer(usbd, i, ep_addr, packet);
     usbd->stream_objs[i][0] = ring;
-    s->ring = MP_OBJ_TO_PTR(ring);
