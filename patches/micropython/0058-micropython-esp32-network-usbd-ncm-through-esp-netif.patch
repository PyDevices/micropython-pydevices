 ports/esp32/usb.c                   |   8 +
 shared/tinyusb/mp_usbd_descriptor.c |   7 +
 shared/tinyusb/tusb_config.h        |  16 +-
 6 files changed, 303 insertions(+), 2 deletions(-)
 create mode 100644 ports/esp32/network_usbd_ncm.c

