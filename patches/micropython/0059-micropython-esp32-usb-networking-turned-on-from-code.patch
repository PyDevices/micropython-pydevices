+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+ * THE SOFTWARE.
+ */
+
+// network.USBD_NCM on the ESP32: Ethernet over USB (CDC-NCM) as an esp_netif
+// with a custom I/O driver, in place of extmod/network_usbd_ncm.c. That one
+// drives lwIP's raw API, which ESP-IDF only allows from its own tcpip task.
+//
+// NCM isn't in the built-in descriptor here. Code turns it on by adding a
+// CDC-NCM function through machine.USBDevice (usb-device-net), which makes
+// this object first: that allocates TinyUSB's transfer blocks and the netif,
+// and TinyUSB's NCM driver takes the function's interfaces when the computer
+// configures the device. Until then NCM costs code space only.
+//
+// The board is the NCM link's one end, at a link-local address of its own, and
+// leases the computer an address beside it from ESP-IDF's DHCP server, with no
+// gateway so the computer's internet route doesn't move. TinyUSB runs from
+// MicroPython's scheduler, so frames the network stack sends are copied into a
+// queue and handed to it there. Received frames are copied out of TinyUSB's
+// buffer, which it reuses as soon as the callback returns, and handed to
+// esp_netif_receive(): the stack keeps that copy until it is done with it and
+// gives it back through ncm_free_rx_buffer().
+
+#include "py/runtime.h"
+#include "py/mphal.h"
+#include "py/mperrno.h"
+
+#if MICROPY_PY_NETWORK_USBD_NCM
+
+#include <string.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "esp_mac.h"
+#include "esp_timer.h"
+#include "esp_netif.h"
+#include "esp_netif_net_stack.h"
+#include "esp_heap_caps.h"
+
+#include "shared/tinyusb/mp_usbd.h"
+#include "modnetwork.h"
+
+#define NCM_TX_QUEUE_LEN (8)
+
+typedef struct _ncm_frame_t {
+    uint16_t len;
+    uint8_t data[];
+} ncm_frame_t;
+
+// The computer's end of the link: the chip's Ethernet MAC, marked locally
+// administered. The board's end is the same with the last bit flipped.
+// config("mac") reports the computer's, as the other ports do, and
+// usb-device-net writes it into the descriptor's iMACAddress string.
+static uint8_t ncm_host_mac[6];
+
+const mp_obj_type_t mod_network_nic_type_ncm;
+
+static base_if_obj_t ncm_obj;
+static esp_netif_t *ncm_netif;
+static QueueHandle_t ncm_tx_queue;
+static mp_sched_node_t ncm_tx_node;
+static esp_timer_handle_t ncm_tx_retry;
+static volatile bool ncm_link;
+
+// Frames the network stack hands the driver: copy, queue, and let the
+// scheduler carry them to TinyUSB. A full queue drops the frame, which TCP
+// sends again. While TinyUSB's transmit blocks are full the frame stays
+// queued, and a timer tries again a moment later.
+static void ncm_tx_callback(mp_sched_node_t *node);
+static void ncm_set_link(bool up);
+
+static esp_err_t ncm_transmit(void *handle, void *buffer, size_t len) {
+    (void)handle;
+    if (!ncm_link || len == 0 || len > CFG_TUD_NET_MTU) {
+        return ESP_OK;
+    }
+    ncm_frame_t *frame = malloc(sizeof(ncm_frame_t) + len);
+    if (frame == NULL) {
+        return ESP_OK;
+    }
+    frame->len = len;
+    memcpy(frame->data, buffer, len);
+    if (xQueueSend(ncm_tx_queue, &frame, 0) != pdTRUE) {
+        free(frame);
+        return ESP_OK;
+    }
+    mp_sched_schedule_node(&ncm_tx_node, ncm_tx_callback);
+    // The stack runs in its own task: wake MicroPython's if it is waiting.
+    mp_hal_wake_main_task();
+    return ESP_OK;
+}
+
+static void ncm_tx_retry_cb(void *arg) {
+    (void)arg;
+    mp_sched_schedule_node(&ncm_tx_node, ncm_tx_callback);
+    mp_hal_wake_main_task();
+}
+
+static void ncm_free_rx_buffer(void *handle, void *buffer) {
+    (void)handle;
+    free(buffer);
+}
+
+static void ncm_tx_callback(mp_sched_node_t *node) {
+    (void)node;
+    ncm_frame_t *frame;
+    while (xQueuePeek(ncm_tx_queue, &frame, 0) == pdTRUE) {
+        if (tud_ready() && !tud_network_can_xmit(frame->len)) {
+            // TinyUSB's blocks are full until the computer reads one.
+            esp_timer_start_once(ncm_tx_retry, 1000);
+            return;
+        }
+        xQueueReceive(ncm_tx_queue, &frame, 0);
+        if (tud_ready()) {
+            tud_network_xmit(frame, frame->len);
+        }
+        free(frame);
+    }
+}
+
+uint16_t tud_network_xmit_cb(uint8_t *dst, void *ref, uint16_t arg) {
+    memcpy(dst, ((ncm_frame_t *)ref)->data, arg);
+    return arg;
+}
+
+bool tud_network_recv_cb(const uint8_t *src, uint16_t size) {
+    if (!ncm_link) {
+        ncm_set_link(true);
+    }
+    if (ncm_netif != NULL && ncm_link && size) {
+        // The stack holds on to the buffer it is given, past this callback,
+        // and frees it through ncm_free_rx_buffer(), so it gets a copy. A
+        // failed allocation drops the frame.
+        void *frame = malloc(size);
+        if (frame != NULL) {
+            memcpy(frame, src, size);
+            esp_netif_receive(ncm_netif, frame, size, NULL);
+        }
+    }
+    tud_network_recv_renew();
+    return true;
+}
+
+// A link-local address from the MAC, 169.254.x.1, as the other ports'
+// driver chooses.
+static uint32_t ncm_address(const uint8_t *mac) {
+    size_t hash = qstr_compute_hash(mac, 6);
+    uint8_t third = (uint8_t)(hash ^ (hash >> 8));
+    if (third == 0) {
+        third = 1;
+    } else if (third == 255) {
+        third = 254;
+    }
+    return esp_netif_htonl((169u << 24) | (254u << 16) | ((uint32_t)third << 8) | 1u);
+}
+
+static void ncm_netif_create(void) {
+    if (ncm_netif != NULL) {
+        return;
+    }
+    // The netif layer starts on first use, as it does for Wi-Fi and Ethernet.
+    mp_call_function_0(MP_OBJ_FROM_PTR(&esp_network_initialize_obj));
+
+    // TinyUSB's transfer blocks, once: DMA-capable internal RAM, aligned
+    // for the controller and its cache.
+    void *blocks = heap_caps_aligned_alloc(64, netd_buffer_size(), MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
+    if (blocks == NULL) {
+        mp_raise_OSError(MP_ENOMEM);
+    }
+    memset(blocks, 0, netd_buffer_size());
+    netd_set_buffer(blocks);
+
+    // The board's end of the link is the computer's address with the last bit flipped.
+    esp_read_mac(ncm_host_mac, ESP_MAC_ETH);
+    ncm_host_mac[0] = 0x02;
+    static uint8_t mac[6];
+    memcpy(mac, ncm_host_mac, sizeof(mac));
+    mac[5] ^= 0x01;
+    static esp_netif_ip_info_t ip_info;
+    ip_info.ip.addr = ncm_address(ncm_host_mac);
+    ip_info.netmask.addr = esp_netif_htonl(0xFFFF0000);
+    ip_info.gw.addr = ip_info.ip.addr;
+
+    static const esp_netif_inherent_config_t base = {
+        .flags = ESP_NETIF_DHCP_SERVER | ESP_NETIF_FLAG_AUTOUP,
+        .ip_info = &ip_info,
+        .if_key = "USBD_NCM",
+        .if_desc = "usbd_ncm",
+        .route_prio = 5,
+    };
+    static esp_netif_driver_ifconfig_t driver = {
+        .handle = (void *)1,
+        .transmit = ncm_transmit,
+        .driver_free_rx_buffer = ncm_free_rx_buffer,
+    };
+    const esp_netif_config_t config = {
+        .base = &base,
+        .driver = &driver,
+        .stack = ESP_NETIF_NETSTACK_DEFAULT_ETH,
+    };
+
+    ncm_tx_queue = xQueueCreate(NCM_TX_QUEUE_LEN, sizeof(ncm_frame_t *));
+    if (ncm_tx_queue == NULL) {
+        mp_raise_OSError(MP_ENOMEM);
+    }
+    const esp_timer_create_args_t retry_args = {
+        .callback = ncm_tx_retry_cb,
+        .name = "ncm_tx",
+    };
+    check_esp_err(esp_timer_create(&retry_args, &ncm_tx_retry));
+    ncm_netif = esp_netif_new(&config);
+    if (ncm_netif == NULL) {
+        mp_raise_OSError(MP_ENOMEM);
+    }
+    esp_netif_set_mac(ncm_netif, mac);
+    // No default gateway for the computer: this link goes nowhere else.
+    uint8_t no_router = 0;
+    esp_netif_dhcps_stop(ncm_netif);
+    esp_netif_dhcps_option(ncm_netif, ESP_NETIF_OP_SET, ESP_NETIF_ROUTER_SOLICITATION_ADDRESS, &no_router, sizeof(no_router));
+    esp_netif_action_start(ncm_netif, NULL, 0, NULL);
+    esp_netif_dhcps_start(ncm_netif);
+
+    ncm_obj.base.type = &mod_network_nic_type_ncm;
+    ncm_obj.if_id = ESP_IF_MAX;
+    ncm_obj.netif = ncm_netif;
+}
+
+static void ncm_set_link(bool up) {
+    ncm_netif_create();
+    if (up == ncm_link) {
+        return;
+    }
+    ncm_link = up;
+    ncm_obj.active = up;
+    if (up) {
+        esp_netif_action_connected(ncm_netif, NULL, 0, NULL);
+    } else {
+        esp_netif_action_disconnected(ncm_netif, NULL, 0, NULL);
+    }
+}
+
+// NCM tells the application nothing when the computer switches the data
+// interface on, so the link comes up with the first thing the computer says:
+// the Ethernet packet filter it sets once the interface is on, or its first
+// frame, whichever TinyUSB reports first. The netif exists from then on.
+void tud_network_set_packet_filter_cb(uint16_t packet_filter) {
+    (void)packet_filter;
+    ncm_set_link(true);
+}
+
+static mp_obj_t ncm_make_new(const mp_obj_type_t *type, size_t n_args, size_t n_kw, const mp_obj_t *args) {
+    mp_arg_check_num(n_args, n_kw, 0, 0, false);
+    ncm_netif_create();
+    return MP_OBJ_FROM_PTR(&ncm_obj);
+}
+
+// active(): whether the computer has the link up; active(False) takes it
+// down from this end and active(True) back up.
+static mp_obj_t ncm_active(size_t n_args, const mp_obj_t *args) {
+    if (n_args > 1) {
+        ncm_set_link(mp_obj_is_true(args[1]));
+    }
+    return mp_obj_new_bool(ncm_link);
+}
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(ncm_active_obj, 1, 2, ncm_active);
+
+static mp_obj_t ncm_isconnected(mp_obj_t self_in) {
+    return mp_obj_new_bool(ncm_link && tud_ready());
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(ncm_isconnected_obj, ncm_isconnected);
+
+// config("mac"): the computer's end of the link. config("ifname"): the
+// board's end, by its ESP-IDF name.
+static mp_obj_t ncm_config(mp_obj_t self_in, mp_obj_t key) {
+    switch (mp_obj_str_get_qstr(key)) {
+        case MP_QSTR_mac:
+            return mp_obj_new_bytes(ncm_host_mac, sizeof(ncm_host_mac));
+        case MP_QSTR_ifname:
+            return esp_ifname(ncm_netif);
+        default:
+            mp_raise_ValueError(MP_ERROR_TEXT("unknown config param"));
+    }
+}
+static MP_DEFINE_CONST_FUN_OBJ_2(ncm_config_obj, ncm_config);
+
+static const mp_rom_map_elem_t ncm_locals_dict_table[] = {
+    { MP_ROM_QSTR(MP_QSTR_active), MP_ROM_PTR(&ncm_active_obj) },
+    { MP_ROM_QSTR(MP_QSTR_isconnected), MP_ROM_PTR(&ncm_isconnected_obj) },
+    { MP_ROM_QSTR(MP_QSTR_config), MP_ROM_PTR(&ncm_config_obj) },
+    { MP_ROM_QSTR(MP_QSTR_ifconfig), MP_ROM_PTR(&esp_network_ifconfig_obj) },
+    { MP_ROM_QSTR(MP_QSTR_ipconfig), MP_ROM_PTR(&esp_nic_ipconfig_obj) },
+};
+static MP_DEFINE_CONST_DICT(ncm_locals_dict, ncm_locals_dict_table);
+
+MP_DEFINE_CONST_OBJ_TYPE(
+    mod_network_nic_type_ncm,
+    MP_QSTR_USBD_NCM,
+    MP_TYPE_FLAG_NONE,
+    make_new, ncm_make_new,
+    locals_dict, &ncm_locals_dict
+    );
+
+#endif // MICROPY_PY_NETWORK_USBD_NCM
diff --git a/shared/tinyusb/mp_usbd.h b/shared/tinyusb/mp_usbd.h
index 06d905a75..64d799fd9 100644
--- a/shared/tinyusb/mp_usbd.h
+++ b/shared/tinyusb/mp_usbd.h
@@ -94,7 +94,7 @@ void mp_usbd_hex_str(char *out_str, const uint8_t *bytes, size_t bytes_len);
 #define MP_USBD_BUILTIN_DESC_CFG_LEN ( \
     (CFG_TUD_CDC ? (TUD_CDC_DESC_LEN) : 0) + \
     (CFG_TUD_MSC ? (TUD_MSC_DESC_LEN) : 0) + \
-    (CFG_TUD_NCM ? (TUD_CDC_NCM_DESC_LEN) : 0) + \
+    (MICROPY_HW_USB_NCM_BUILTIN ? (TUD_CDC_NCM_DESC_LEN) : 0) + \
     TUD_CONFIG_DESC_LEN)
 
 // Built-in USB device and configuration descriptor values
diff --git a/shared/tinyusb/mp_usbd_descriptor.c b/shared/tinyusb/mp_usbd_descriptor.c
index f6b1fe929..1a548ce2b 100644
--- a/shared/tinyusb/mp_usbd_descriptor.c
+++ b/shared/tinyusb/mp_usbd_descriptor.c
@@ -80,7 +80,7 @@ const uint8_t mp_usbd_builtin_desc_cfg[MP_USBD_BUILTIN_DESC_CFG_LEN] = {
     #if CFG_TUD_MSC
     TUD_MSC_DESCRIPTOR(USBD_ITF_MSC, USBD_STR_MSC, USBD_MSC_EP_OUT, USBD_MSC_EP_IN, USBD_MSC_IN_OUT_MAX_SIZE),
     #endif
-    #if CFG_TUD_NCM
+    #if MICROPY_HW_USB_NCM_BUILTIN
     // Interface number, description string index, MAC address string index, EP notification address and size, EP data address (out, in), and size, max segment size, notification interval, network capabilities.
     TUD_CDC_NCM_DESCRIPTOR(USBD_ITF_NCM, USBD_STR_NCM, USBD_STR_NCM_MAC, USBD_NCM_EP_CMD, 64, USBD_NCM_EP_OUT, USBD_NCM_EP_IN, USBD_NCM_IN_OUT_MAX_SIZE, CFG_TUD_NET_MTU, 50, 0),
     #endif
@@ -135,12 +135,19 @@ const uint16_t *tud_descriptor_string_cb(uint8_t index, uint16_t langid) {
                 desc_str = MICROPY_HW_USB_MSC_INTERFACE_STRING;
                 break;
             #endif
-            #if CFG_TUD_NCM
+            #if MICROPY_HW_USB_NCM_BUILTIN
             case USBD_STR_NCM:
                 desc_str = MICROPY_PY_NETWORK_USBD_NCM_INTERFACE_STRING;
                 break;
             case USBD_STR_NCM_MAC:
                 mp_usbd_hex_str(serial_buf, (uint8_t *)tud_network_mac_address, sizeof(tud_network_mac_address));
+                // CDC-ECM and NCM write the address as upper-case hex digits,
+                // which Windows' driver insists on.
+                for (char *c = serial_buf; *c; c++) {
+                    if (*c >= 'a' && *c <= 'f') {
+                        *c -= 'a' - 'A';
+                    }
+                }
                 desc_str = serial_buf;
                 break;
             #endif
diff --git a/shared/tinyusb/mp_usbd_runtime.c b/shared/tinyusb/mp_usbd_runtime.c
index f287d0a47..d04e039e2 100644
--- a/shared/tinyusb/mp_usbd_runtime.c
+++ b/shared/tinyusb/mp_usbd_runtime.c
@@ -293,6 +293,16 @@ static uint16_t runtime_dev_open(uint8_t rhport, tusb_desc_interface_t const *it
     }
     #endif
 
+    #if CFG_TUD_NCM && !MICROPY_HW_USB_NCM_BUILTIN
+    // A CDC-NCM function in the descriptor is left to TinyUSB's NCM driver,
+    // next in line, which moves its frames to and from the network stack in
+    // C. Python only wrote its descriptors (usb-device-net).
+    if (itf_desc->bInterfaceClass == TUSB_CLASS_CDC
+        && itf_desc->bInterfaceSubClass == CDC_COMM_SUBCLASS_NETWORK_CONTROL_MODEL) {
+        return 0;
+    }
+    #endif
+
     // Determine the total descriptor length of the interface(s) we are going to claim
     uint8_t assoc_itf_count = _runtime_dev_count_itfs(itf_desc);
