diff --git a/ports/esp32/mpconfigport.h b/ports/esp32/mpconfigport.h
index c2939a812..4ff9e3da7 100644
--- a/ports/esp32/mpconfigport.h
+++ b/ports/esp32/mpconfigport.h
@@ -283,6 +283,18 @@
 #define MICROPY_HW_ENABLE_USB_RUNTIME_DEVICE    (1) // Support machine.USBDevice
 #endif
 
+// Ethernet over USB (CDC-NCM): network.USBD_NCM and TinyUSB's NCM driver are
+// compiled in wherever the runtime USB device and the network stack are, but
+// NCM isn't in the built-in descriptor. Code turns it on with a CDC-NCM
+// function of its own through machine.USBDevice (usb-device-net), so it costs
+// no endpoints, and its transfer blocks no RAM, until then.
+#ifndef MICROPY_PY_NETWORK_USBD_NCM
+#define MICROPY_PY_NETWORK_USBD_NCM             (MICROPY_HW_ENABLE_USB_RUNTIME_DEVICE && MICROPY_PY_NETWORK)
+#endif
