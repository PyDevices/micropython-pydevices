index 436f8dc..561c35b 100644
--- a/src/portable/synopsys/dwc2/dwc2_esp32.h
+++ b/src/portable/synopsys/dwc2/dwc2_esp32.h
@@ -117,7 +117,15 @@ TU_ATTR_ALWAYS_INLINE static inline void dwc2_clock_init(uint8_t rhport, tusb_ro
 
 TU_ATTR_ALWAYS_INLINE static inline void dwc2_int_set(uint8_t rhport, tusb_role_t role, bool enabled) {
   if (enabled) {
-    esp_intr_alloc(_dwc2_controller[rhport].irqnum, ESP_INTR_FLAG_LOWMED,
+    int flags = ESP_INTR_FLAG_LOWMED;
+    #if TUP_DCD_ISR_IN_IRAM
+    // The device interrupt is in IRAM (linker.lf) and runs while the cache is
+    // off; the host one is not.
+    if (role == TUSB_ROLE_DEVICE) {
+      flags |= ESP_INTR_FLAG_IRAM;
+    }
+    #endif
+    esp_intr_alloc(_dwc2_controller[rhport].irqnum, flags,
                    dwc2_int_handler_wrap, (void*)(uintptr_t)tu_u16(role, rhport), &usb_ih[rhport]);
   } else {
     esp_intr_free(usb_ih[rhport]);
-- 
