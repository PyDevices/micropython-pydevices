# usbhost's USB host settings, appended to every esp32 build that selects usbhost
# (micropython-pydevices' build_mp.py finds this file by name).
#
# External hub support is off by default upstream, which makes a hub
# enumerate as a device the host stack cannot use with everything behind it
# invisible; a powered hub is also how a board that cannot source
# VBUS reaches a bus-powered peripheral at all. The control-transfer buffer is
# raised from IDF's 256-byte default because IDF allocates one per attached
# device and refuses any device whose configuration descriptor is larger: a
# USB audio CODEC publishes 1191 bytes, the bench camera 2306, and at the
# default they never enumerate -- no error, no event, just absent.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
#
# A hub port's reset recovery is raised from 30 ms to 100 ms. IDF counts it
# from asking the hub to reset the port, not from the reset ending, so the
# hub's own reset time comes out of it; an FT232R behind a powered hub on an
# ESP32-S3 then missed its first descriptor request ("EP 0 Error") on every
# attach, and its port stayed disabled until a replug. At 100 ms it enumerated
# on every attach tried; a device behind a hub takes about 0.15 s longer to
# appear (two resets each).
CONFIG_USB_HOST_EXT_PORT_RESET_RECOVERY_DELAY_MS=100
