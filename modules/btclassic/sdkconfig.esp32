# btclassic: Bluedroid with Classic, A2DP sink, AVRCP and HFP, in place of the
# NimBLE host MicroPython's BLE module uses. The controller runs both Classic
# and BLE (dual mode), and the `bluetooth` module runs on Bluedroid too.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
# BLE for the `bluetooth` module: the GATT server so far; no client or
# pairing yet.
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n
CONFIG_BT_AVRCP_ENABLED=y
# Bluedroid's buffers go to PSRAM when the board has it, leaving internal
# RAM to the controller and MicroPython.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# AVRCP 1.6 cover art: the album image, over OBEX (GOEP client).
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y
# Hands-free unit (HFP), for the phone's battery, signal, carrier and calls.
# Call audio both ways goes over HCI as PCM, which Bluedroid codes as CVSD
# or wideband mSBC; the controller keeps one link for it.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1

# Serial port (SPP over RFCOMM).
CONFIG_BT_SPP_ENABLED=y

# HID: the board as a keyboard, mouse or gamepad, or the host of one. One
# role runs at a time; each takes the two HID L2CAP channels while it does.
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
