# btclassic on the ESP32-S31: the same Bluedroid host as sdkconfig.esp32 (its
# comments say why each line is there), on the S31's dual-mode controller,
# which ESP-IDF 6.1 configures with its own BT_CTRL_* names.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y

# The controller doesn't sleep: with BR/EDR on, sleeping needs a 32.768 kHz
# crystal as its low-power clock, which a board may not have.
CONFIG_BT_CTRL_SLEEP_ENABLE=n

CONFIG_BT_BLE_ENABLED=y
# The `bluetooth` backend advertises, scans and connects with Bluedroid's
# legacy (BLE 4.2) calls, which ESP-IDF 6.1 leaves out of every chip but the
# ESP32 unless asked. The two sets don't build together.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_SMP_BOND_NVS_FLASH=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_L2CAP_ENABLED=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y

# Hands-free unit and audio gateway, call audio over HCI.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BT_CTRL_BR_EDR_MAX_SYNC_CONN=1

CONFIG_BT_SPP_ENABLED=y

# Three Classic links, as on the ESP32.
CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=3

CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
CONFIG_BT_PBAC_ENABLED=y
