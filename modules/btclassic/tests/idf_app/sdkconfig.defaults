CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
# Raw L2CAP channels (btclassic.L2CAP), through Bluedroid's L2CAP VFS.
CONFIG_BT_L2CAP_ENABLED=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y

# Phone book access (PBAP client, over OBEX): contacts and call history.
CONFIG_BT_PBAC_ENABLED=y
# Messages (MAP client) finds the phone's message service, and advertises
# where the phone sends its reports, through SDP.
CONFIG_BT_SDP_COMMON_ENABLED=y
