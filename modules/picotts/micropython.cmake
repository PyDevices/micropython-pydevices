# picotts CMake glue (see micropython.mk for what the settings mean).

set(PICOTTS_DIR ${CMAKE_CURRENT_LIST_DIR})
set(PICOTTS_SVOX ${PICOTTS_DIR}/third_party/svox)

# The esp32 port compiles user C modules with -Werror=all, and per-file flags
# don't reach them there, so the SVOX engine (third-party code, left as it
# came) builds through one small wrapper per file that turns its warnings off
# and includes the original.
set(PICOTTS_WRAP ${CMAKE_CURRENT_BINARY_DIR}/picotts_svox)
file(MAKE_DIRECTORY ${PICOTTS_WRAP})
file(GLOB PICOTTS_SVOX_SRC ${PICOTTS_SVOX}/*.c)
set(PICOTTS_SVOX_WRAPPED)
foreach(src ${PICOTTS_SVOX_SRC})
    get_filename_component(name ${src} NAME)
    set(wrapped ${PICOTTS_WRAP}/${name})
    set(body "/* Generated by modules/picotts/micropython.cmake. */\n")
    foreach(w maybe-uninitialized uninitialized unused-variable
              unused-but-set-variable unused-function unused-parameter
              unused-value unused-label sign-compare implicit-fallthrough
              missing-field-initializers old-style-declaration type-limits
              misleading-indentation parentheses empty-body
              int-in-bool-context array-bounds stringop-overflow address
              pointer-sign char-subscripts dangling-else switch format
              shift-negative-value bool-operation)
        string(APPEND body "#pragma GCC diagnostic ignored \"-W${w}\"\n")
    endforeach()
    string(APPEND body "#include \"${src}\"\n")
    file(CONFIGURE OUTPUT ${wrapped} CONTENT "${body}" @ONLY)
    list(APPEND PICOTTS_SVOX_WRAPPED ${wrapped})
endforeach()

add_library(usermod_picotts INTERFACE)
target_sources(usermod_picotts INTERFACE
    ${PICOTTS_DIR}/src/modpicotts.c
    ${PICOTTS_SVOX_WRAPPED}
)
target_include_directories(usermod_picotts INTERFACE ${PICOTTS_SVOX})
target_compile_definitions(usermod_picotts INTERFACE PICO_PLATFORM=PICO_CIRCUITPY)
target_link_libraries(usermod INTERFACE usermod_picotts)
