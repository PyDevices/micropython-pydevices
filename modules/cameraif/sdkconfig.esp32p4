# Sensors that send YUV or RGB rather than Bayer, and the two HDMI-to-CSI
# bridges. cameraif finds and names them, then says it can't stream them: the
# P4's ISP takes only Bayer input.
CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
