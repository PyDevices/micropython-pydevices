+CONFIG_CAMERA_TC358743_MIPI_YUV422_1920X1080_30FPS=y
+
+# The sensor's clock. cameraif drives it itself when Camera(xclk=pin) is given,
+# because the sensor drivers leave it to the caller: the router on the P4 first,
+# which divides 480 MHz, so 24 MHz on the ESP32-P4-EYE, and LEDC for a
+# frequency the router can't make.
+CONFIG_CAMERA_XCLK_USE_ESP_CLOCK_ROUTER=y
+CONFIG_CAMERA_XCLK_USE_LEDC=y
