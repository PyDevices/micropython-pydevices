+CONFIG_CAMERA_SC132GS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_SC132GS_MIPI_RAW10_544X640_60FPS=y
+CONFIG_CAMERA_SC132GS_MIPI_RAW10_1080X1280_60FPS=y
+
+CONFIG_CAMERA_SC1346=y
+CONFIG_CAMERA_SC1346_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_SC1346_MIPI_RAW10_1280X720_25FPS=y
+CONFIG_CAMERA_SC1346_MIPI_RAW10_1280X720_30FPS=y
+CONFIG_CAMERA_SC1346_MIPI_RAW8_1280X720_30FPS=y
+
+CONFIG_CAMERA_SC202CS=y
+CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_SC202CS_MIPI_RAW8_1280X720_30FPS=y
+CONFIG_CAMERA_SC202CS_MIPI_RAW8_1600X1200_30FPS=y
+CONFIG_CAMERA_SC202CS_MIPI_RAW10_1600X900_30FPS=y
+CONFIG_CAMERA_SC202CS_MIPI_RAW10_1600X1200_30FPS=y
+
+CONFIG_CAMERA_SC2331=y
+CONFIG_CAMERA_SC2331_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
