+
+CONFIG_CAMERA_OV5645=y
+CONFIG_CAMERA_OV5645_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_OV5645_MIPI_RGB565_1280X960_30FPS=y
+CONFIG_CAMERA_OV5645_MIPI_YUV420_1280X960_30FPS=y
+CONFIG_CAMERA_OV5645_MIPI_YUV422_640X480_24FPS=y
+CONFIG_CAMERA_OV5645_MIPI_YUV422_1280X960_30FPS=y
+CONFIG_CAMERA_OV5645_MIPI_YUV422_1920X1080_15FPS=y
+CONFIG_CAMERA_OV5645_MIPI_YUV422_2592X1944_15FPS=y
+
+CONFIG_CAMERA_SC121AT=y
+CONFIG_CAMERA_SC121AT_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_SC121AT_AUTO_DETECT_DVP_INTERFACE_SENSOR=n
+CONFIG_CAMERA_SC121AT_MIPI_YUV422_1280X800_25FPS=y
+CONFIG_CAMERA_SC121AT_MIPI_YUV422_1280X960_30FPS=y
+
+CONFIG_CAMERA_TC358743=y
+CONFIG_CAMERA_TC358743_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
