+CONFIG_CAMERA_SC2336_MIPI_RAW10_800X800_30FPS=y
+CONFIG_CAMERA_SC2336_MIPI_RAW10_1280X720_30FPS=y
+CONFIG_CAMERA_SC2336_MIPI_RAW10_1280X720_50FPS=y
+CONFIG_CAMERA_SC2336_MIPI_RAW10_1280X720_60FPS=y
