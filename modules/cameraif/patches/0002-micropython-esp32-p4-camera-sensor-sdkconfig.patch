+CONFIG_CAMERA_MIT245=y
+CONFIG_CAMERA_MIT245_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_MIT245_MIPI_RAW8_1920X1080_30FPS=y
+CONFIG_CAMERA_MIT245_MIPI_RAW10_1920X1080_30FPS=y
