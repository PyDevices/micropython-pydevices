+CONFIG_CAMERA_OS04C10_MIPI_RAW10_960X1280_30FPS=y
+CONFIG_CAMERA_OS04C10_MIPI_RAW10_1280X720_25FPS=y
+
+CONFIG_CAMERA_OV2710=y
+CONFIG_CAMERA_OV2710_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y
+CONFIG_CAMERA_OV2710_MIPI_RAW10_1920X1080_25FPS=y
+
+CONFIG_CAMERA_OV9281=y
+CONFIG_CAMERA_OV9281_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_OV9281_MIPI_RAW8_640X400_100FPS=y
