+CONFIG_CAMERA_STI2250=y
+CONFIG_CAMERA_STI2250_AUTO_DETECT=y
+CONFIG_CAMERA_STI2250_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_STI2250_MIPI_RAW8_800X600_50FPS=y
+
+# Sensors that send YUV or RGB rather than Bayer, and the two HDMI-to-CSI
+# bridges. cameraif finds and names them, then says it can't stream them: the
+# P4's ISP takes only Bayer input.
+CONFIG_CAMERA_GC2145=y
+CONFIG_CAMERA_GC2145_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_GC2145_AUTO_DETECT_DVP_INTERFACE_SENSOR=n
+CONFIG_CAMERA_GC2145_MIPI_RGB565_640X480_15FPS=y
+CONFIG_CAMERA_GC2145_MIPI_RGB565_800X600_30FPS=y
+CONFIG_CAMERA_GC2145_MIPI_RGB565_1600X1200_7FPS=y
+
+CONFIG_CAMERA_LT6911=y
+CONFIG_CAMERA_LT6911_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_LT6911_MIPI_YUV422_1280X720_60FPS=y
+CONFIG_CAMERA_LT6911_MIPI_YUV422_1920X1080_48FPS=y
+
+CONFIG_CAMERA_OV5640=y
+CONFIG_CAMERA_OV5640_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
+CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=n
