+// Inference runs without the GIL, so other threads keep running while the
+// model works. It touches only the model's own buffers; use one model object
+// from one thread at a time, and don't deinit() it while detect() runs.
+static void espdl_run(dl::Model *model)
+{
+    MP_THREAD_GIL_EXIT();
+    model->run();
+    MP_THREAD_GIL_ENTER();
+}
