# Filled on demand by build_mp.py: symlinks in the workspace, clones elsewhere.
/micropython
/deps/
/builds/
# modules/ holds symlinks or clones, except what this repository tracks.
/modules/*
!/modules/manifest.py
!/modules/all/
!/modules/castif/
!/modules/h264enc/
!/modules/tsmux/
!/modules/ppa/
!/modules/jpegio/
!/modules/pngio/
!/modules/tflite/
!/modules/vision/
!/modules/.esp-vision/
/modules/.esp-vision/src
/.worktrees/
__pycache__/
/.micropython-build.lock
