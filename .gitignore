# Filled on demand by build_mp.py: symlinks in the workspace, clones elsewhere.
/micropython
/deps/
/builds/
# modules/ holds symlinks or clones, except what this repository tracks.
/modules/*
!/modules/manifest.py
!/modules/library.py
!/modules/pydevices/
!/modules/palettes/
!/modules/pdwidgets/
!/modules/audiocomponents/
!/modules/micropython-lib/
!/modules/all/
!/modules/castif/
!/modules/usbhost/
!/modules/audioif/
!/modules/cameraif/
!/modules/displayif/
!/modules/h264enc/
!/modules/tsmux/
!/modules/ppa/
!/modules/jpegio/
!/modules/mdns/
!/modules/pngio/
!/modules/picotts/
!/modules/tflite/
!/modules/vision/
!/modules/.esp-vision/
/modules/.esp-vision/src
/.worktrees/
__pycache__/
/.micropython-build.lock
/_site/
/.venv-docs/
