{
  "name": "rp2: Raspberry Pi Pico and Pico 2",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "PORT": "rp2"
    }
  },
  "mounts": [
    "source=pydevices-deps-${devcontainerId},target=${containerWorkspaceFolder}/deps,type=volume"
  ],
  "onCreateCommand": "sh .devcontainer/on-create.sh",
  "postCreateCommand": "echo 'To build: ./build_mp.py --port rp2 --board RPI_PICO2 --modules all'"
}
