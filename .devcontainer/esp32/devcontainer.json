{
  "name": "esp32: ESP32-S3, ESP32-P4 and the other ESP chips",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "PORT": "esp32"
    }
  },
  "mounts": [
    "source=pydevices-deps-${devcontainerId},target=${containerWorkspaceFolder}/deps,type=volume"
  ],
  "containerEnv": {
    "IDF_TOOLS_PATH": "${containerWorkspaceFolder}/deps/espressif-tools"
  },
  "hostRequirements": {
    "cpus": 4,
    "storage": "32gb"
  },
  "onCreateCommand": "sh .devcontainer/on-create.sh && sh .devcontainer/esp32/prefetch.sh",
  "postCreateCommand": "echo 'To build: ./build_mp.py --port esp32 --board ESP32_GENERIC_S3 --variant SPIRAM_OCT --flash 8MB --modules all'"
}
