# Ai-Thinker ESP32-Audio-Kit (ESP32-A1S module): flash and PSRAM at 80 MHz.
# On a classic ESP32 they share one bus with the code the Bluetooth stack runs
# from, and at the default 40 MHz a program busy in PSRAM (redrawing, decoding
# a cover) held it long enough to lose a call's microphone audio: 8 or 9
# dropouts in 15 s of tone, against none in 13 calls at 80 MHz.
# The flash clock is set in the bootloader, so write it with the app.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED_40M=n

# Logs, not features: Bluedroid's trace strings and every IDF log under ERROR
# come out, which is about 220 KB of the image. Errors still print.
CONFIG_BT_STACK_NO_LOG=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=n
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y
