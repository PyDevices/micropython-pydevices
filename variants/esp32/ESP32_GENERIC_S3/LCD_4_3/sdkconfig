# Waveshare ESP32-S3-Touch-LCD-4.3: the tuning that is this board's alone, on
# top of every S3's (variants/esp32/sdkconfig.esp32s3). CircuitPython's build
# for this board carries the same three cache settings and a 1 ms tick; the
# LCD-7 variant has all four.
#
# lv_test_timer's frame rate on the board (`kit` run, median of three):
#   port defaults                10.4 fps
#   caches only                  11.7
#   1 ms tick only               17.7
#   both, as below               17.7 (16.6 averaged over the whole run, 9.3
#                                      with the defaults)

# 1 ms tick. DotClockFramebuffer.refresh() waits for the panel to take the new
# frame buffer by polling with vTaskDelay(1), and at the port's 100 Hz that is
# a 10 ms sleep: every LVGL present spent 30 ms there, 14-16 ms with this.
CONFIG_FREERTOS_HZ=1000

# Caches sized for LVGL. Its code runs from flash and its objects and
# framebuffers live in PSRAM, which the RGB scanout is streaming from at the
# same time; with the port's 16 KB instruction cache, 32 KB data cache and
# 32-byte lines, LVGL's draw work took 16 ms of a frame and takes 9 ms with
# these. They take 48 KB of internal RAM.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
