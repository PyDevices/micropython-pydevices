# Every ESP32-S3 build. These were the shared lines of the T-Embed's and the
# 4.3" board's old sdkconfig.board; every S3 we build for has PSRAM, which the
# mbedTLS and Wi-Fi/lwIP allocations below lean on.

# mbedTLS allocates from PSRAM. MicroPython's default is "Default alloc mode",
# which with SPIRAM_MALLOC_ALWAYSINTERNAL=8192 puts every TLS allocation under
# 8 KB -- contexts, the parsed certificate chain, the 4 KB output buffer -- in
# internal DRAM. That is the pool FreeRTOS task stacks and I2S DMA buffers must
# come from, and on the T-Embed spremote ran it down to 49 KB free with a
# largest block of 23 KB, unable to start its audio thread. The IDF choice
# symbol is loaded after the defaults, so this line wins over the port's.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# No core dump to flash in a standard build; ./build_mp.py --coredump makes a
# troubleshooting build that has one (sdkconfig.coredump beside this file).

# More lwIP sockets. spremote alone holds the AP session, the dealer's TLS
# websocket, mDNS and the pairing listener, and every pairing-HTTP client, DNS
# lookup and phone poll takes one more. With the default 10, the pairing server
# and the dealer were seen dying together under polling while WiFi and the VM
# stayed up (2026-09-16 04:00). Each socket is a few hundred bytes.
CONFIG_LWIP_MAX_SOCKETS=16

# Light heap poisoning: a canary on every block, checked on free. The
# pairing-server thread crashed twice inside a locked heap walk on a garbage
# block header (2026-09-16), so something writes out of bounds in internal
# DRAM. This makes the offending free abort where the damage is, instead of
# a later walk aborting where it is not.
CONFIG_HEAP_POISONING_LIGHT=y

# TCP over a weak link. The port defaults gave lwIP a 5760-byte receive window
# and a 1.5 s minimum RTO; on the T-Embed at -77 dBm a burst of losses backed the
# retransmit timer off until chunk data stopped for 40 s at a time (2026-09-16
# 22:00, ring log). Selective ACK and a 1 s RTO, with the WiFi and lwIP buffers
# taken from PSRAM so internal DRAM is not the price. The window is the P4's
# 64 KB: at 32 KB a download through a phone's USB tethering, whose Wi-Fi
# round trips run 20-300 ms, moved at 1.07 Mbit/s; at 64 KB, 4.37.
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RTO_TIME=1000
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48

# A 1 ms tick and caches sized for LVGL, on every S3 board, whether or not it
# shipped with a display: a display added after flashing gets the same speed.
#
# The tick: at the port's 100 Hz, any wait shorter than 10 ms rounds to a whole
# tick. DotClockFramebuffer.refresh() polls for the panel to take the new frame
# with vTaskDelay(1), a 10 ms sleep at 100 Hz, and sleep_ms() under one tick
# busy-waits with the GIL held.
#
# The caches: LVGL's code runs from flash and its objects and frame buffers
# live in PSRAM, so the port's 16 KB instruction cache, 32 KB data cache and
# 32-byte lines starve it. Together these take 48 KB of internal RAM.
#
# lv_test_timer's kit run, median of three, port defaults -> these four:
#   Waveshare LCD-4.3 (RGB panel)   10.4 -> 17.7 fps (the tick alone: 17.7)
#   LilyGO T-Embed (SPI panel)      59.5 -> 66.9 fps, with the frame period at
#                                   1 ms (at the standard 33 ms it's pinned at
#                                   30 either way); free internal RAM with the
#                                   display up went 175,867 -> 161,295 B
#   Waveshare LCD-7, under its remote UI: a full-screen redraw 205 -> 147 ms
# A 36-minute Wi-Fi and TLS soak on the LCD-4.3 with these never had less than
# 94 KB of internal RAM free.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
